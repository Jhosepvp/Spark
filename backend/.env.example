# --- Server ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- PostgreSQL ---
DATABASE_URL=postgres://spark_user:spark_password@localhost:5432/spark_db
PG_SSL=false

# --- Redis ---
REDIS_URL=redis://localhost:6379
